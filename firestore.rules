rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Any authenticated user can read and write the shared guest list.
    match /shared/guestList {
      allow read, write: if request.auth != null;
    }
    // Any authenticated user can read and write save-error logs.
    match /errors/{errorId} {
      allow read, write: if request.auth != null;
    }
  }
}
